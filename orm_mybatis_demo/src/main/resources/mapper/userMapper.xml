<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huai.mapper.UserMapper">
    <select id="getUserById" resultType="com.huai.entity.User" parameterType="Long">
        select *
        from orm_user
        where id = #{id}
    </select>

    <select id="getUserList" parameterType="com.huai.entity.User" resultType="com.huai.entity.User">
        select *
        from orm_user
        <where>
            <if test="name != null and name != ''">
                and name like concat('%', #{name}, '%')
            </if>
        </where>
    </select>

    <insert id="insertUser" parameterType="com.huai.entity.User" useGeneratedKeys="true" keyProperty="id"
            keyColumn="id">
        insert into orm_user (name, password, salt, email, phone_number, status, create_time)
        values (#{name}, #{password}, #{salt}, #{email}, #{phoneNumber}, #{status}, #{createTime})
    </insert>

    <update id="updateUserInfo" parameterType="com.huai.entity.User">
        update orm_user
        <set>
            <if test="name != null and name != ''">
                name=#{name},
            </if>
            <if test="password != null and password != ''">
                password=#{password},
            </if>
            <if test="salt != null and salt != ''">
                salt=#{salt},
            </if>
            <if test="email != null and email != ''">
                email=#{email},
            </if>
            <if test="phoneNumber != null and phoneNumber != ''">
                phone_number=#{phoneNumber},
            </if>
            <if test="status != null and status != ''">
                status=#{status}
            </if>
        </set>
        where id = #{id}
    </update>

    <delete id="removeUserById">
        delete
        from orm_user
        where id = #{id}
    </delete>
</mapper>